{
  "_comment": "Configurazione Second Brain — Office PC MS-Sandro (16GB RAM, sempre acceso)",
  "_install_path": "Salvare come %USERPROFILE%\\.jsb-config.json",
  "_version": "1.0",
  "machine_id": "office-ms-sandro",
  "vault_path": "C:\\Users\\MS-Sandro\\JSB",
  "claude_code_projects_root": "C:\\Users\\MS-Sandro\\Code",
  "role": "elaborator-quality",
  "_role_options": "elaborator-fast | elaborator-quality | editor-only",
  "ollama": {
    "url": "http://localhost:11434",
    "model_default": "gemma4:e2b",
    "model_quality": "gemma4:e4b",
    "_note": "16GB RAM permette E4B Q4 CPU-only. Lento (2-3 tok/s) ma qualità superiore. E2B come fallback rapido.",
    "timeout_seconds": 300,
    "max_retries": 3
  },
  "ingest": {
    "body_char_limit": 10000,
    "fail_quarantine_after_retries": 3,
    "archive_on_overwrite": true
