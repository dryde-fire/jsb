  "bridge": {
    "enabled": true,
    "auto_distill_on_adr": true,
    "auto_distill_quality_threshold": "manual_review"
  },
  "orchestrator": {
    "_note": "Solo Office PC: orchestra il routing laptop/locale",
    "laptop_ip": "192.168.1.100",
    "laptop_mac": "00-00-00-00-00-00",
    "laptop_vault_path": "C:\\JSB",
    "laptop_wake_timeout_seconds": 90,
    "fallback_local_on_wake_failure": true
  },
  "lightrag": {
    "url": "http://localhost:9621",
    "api_key": "jsb-lightrag-localkey-2026",
    "timeout": 30,
    "_note": "LightRAG gira su questo PC (Docker). URL locale."
  }
}